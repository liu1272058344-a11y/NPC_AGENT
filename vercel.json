{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/internal-beta/:action", "destination": "/api/internal-beta?action=:action" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/assets-cleanup", "schedule": "17 3 * * *" }]
}
